# ============================================================
# Uangku — proteksi dasar (Apache 2.4)
# ============================================================
Options -Indexes
ServerSignature Off

# Blokir file sensitif diakses lewat browser
<FilesMatch "\.(sql|log|ini|sh|bak|old|env)$">
  Require all denied
</FilesMatch>
<Files "_seedtest.php">
  Require all denied
</Files>
<Files ".htaccess">
  Require all denied
</Files>
# Blokir folder .git & file konfigurasi git
RedirectMatch 404 /\.git
<FilesMatch "^(\.gitignore|\.gitattributes)$">
  Require all denied
</FilesMatch>

# Header keamanan
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  # HSTS aktif & berguna saat sudah HTTPS (diabaikan browser di http biasa)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
